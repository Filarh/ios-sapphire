+/*
+ * sapphire 0419: how a thread waits for the GPU. msm_wait() used to sleep 50 us per look, so each thread waiting
+ * for a frame woke ~20000 times a second (one timer interrupt and two context switches each, on this port a
+ * sleep: 16 §5): the fence waiter of backboardd was the first cause of idle entries of the A73 cluster (15-21 %,
+ * a wakeup every 142-217 us; 16 §5.3). kern.sweet_gpu_wait (boot-arg gpu_wait):
+ *   0  as before: 50 us sleeps (the default);
+ *   1  back-off: 50 us, doubling up to kern.sweet_gpu_wait_max_us (500), each sleep with an eighth of it as
+ *      leeway, so the timer can coalesce with others: ~22 wakeups for a 10 ms frame instead of ~200, and at most
+ *      the cap late;
+ *   2  the GPU's interrupt, as kgsl and drm-msm wait: every CACHE_FLUSH_TS the CP writes raises RBBM_INT_0 bit
+ *      20 (CP_CACHE_FLUSH_TS, the only bit unmasked), the GIC takes SPI 177 (INTID 209, level high; DT
+ *      "interrupts = <0 0xb1 4>") to the CPU of MPIDR kern.sweet_gpu_irq_mpidr (boot-arg gpu_irq_mpidr; 0 = the
+ *      first A53, so the A73s are not woken for it), sleh_irq() calls gpu_spi() through sweet_spi_hook, which
+ *      clears the GPU's status and wakes every waiter. A waiter also wakes after kern.sweet_gpu_wait_irq_us
+ *      (2000) without an interrupt and looks, which bounds what a lost interrupt costs (drm-msm's hangcheck
+ *      retires a missed fence the same way, every 500 ms).
+ * Mode 2 is armed when it is chosen (the boot-arg once the service is up, or the sysctl) and disarmed when another
+ * is: CP_EVENT_WRITE's IRQ bit only while armed, RBBM_INT_0_MASK 0 and the line off in the distributor otherwise.
+ * It is not armed if the distributor says SPI 177 is Group 0 (TrustZone's): it is not ours to take. If the line
+ * keeps coming with nothing in RBBM_INT_0_STATUS (64 in a row), gpu_spi() turns it off in the distributor and
+ * the waiters fall back to the back-off (kern.sweet_gpu_irq_stats says "broken").
+ * The GIC part is the first SPI this port takes: pe_fiq.c only sets up the redistributors (SGIs and PPIs), and
+ * the distributor's IROUTER, IPRIORITYR and ICFGR for the line are written here.
+ */
+#define GICD_IGROUPR        0x0080u
+#define GICD_IPRIORITYR     0x0400u
+#define GICD_ICFGR          0x0C00u
+#define GICD_IROUTER        0x6000u
+static int gpu_wait_max_us = 500;               /* kern.sweet_gpu_wait_max_us: the back-off's longest sleep */
+static int gpu_wait_irq_us = 2000;              /* kern.sweet_gpu_wait_irq_us: the longest sleep waiting for the interrupt */
+static int girq_fence_event;                    /* what the waiters sleep on */
+static event_t volatile girq_listener;          /* one more event woken by every fence interrupt (0420: the frame queue) */
+static struct {
+	uint64_t irqs, ts, other, empty, stray, wake_irq, wake_net, arms, disarms;
+	uint32_t last_status, empty_run;
+	bool broken;
+} girq;
+
+extern "C" bool (*volatile sweet_spi_hook)(uint32_t intid);    /* osfmk/arm64/sleh.c, SWEET */
+
+/* In the IRQ handler (sleh_irq), interrupts off: the GPU's line. */
+static bool
+gpu_spi(uint32_t intid)
+{
+	if (intid != GPU_INTID) {
+		return false;
+	}
+	if (!girq_armed || gpu == NULL) {
+		/* not taken any more: off in the distributor, so a level line cannot hold this CPU */
+		if (gicd != NULL) {
+			wr(gicd, GICD_ICENABLER + GPU_INT_WORD, GPU_INT_BIT);
+		}
+		girq.stray++;
+		return true;
+	}
+	uint32_t st = grd(REG_RBBM_INT_0_STATUS);
+	gwr(REG_RBBM_INT_CLEAR_CMD, st);
+	(void)grd(REG_RBBM_INT_0_STATUS);           /* the clear reaches the GPU before the EOI */
+	girq.irqs++;
+	girq.last_status = st;
+	if ((st & RBBM_INT_CACHE_FLUSH_TS) != 0) {
+		girq.ts++;
+		thread_wakeup((event_t)&girq_fence_event);
+		event_t l = girq_listener;
+		if (l != NULL) {
+			thread_wakeup(l);
+		}
+	}
+	if ((st & ~RBBM_INT_CACHE_FLUSH_TS) != 0) {
+		girq.other++;
+	}
+	if (st == 0) {
+		girq.empty++;
+		if (++girq.empty_run >= 64 && gicd != NULL) {
+			wr(gicd, GICD_ICENABLER + GPU_INT_WORD, GPU_INT_BIT);
+			girq.broken = true;
+			girq_armed = 0;
+		}
+	} else {
+		girq.empty_run = 0;
+	}
+	return true;
+}
+
+/* 0419: take the GPU's interrupt. service_lock held. */
+static bool
+girq_arm(void)
+{
+	if (girq_armed) {
+		return true;
+	}
+	if (gicd == NULL || gpu == NULL) {
+		return false;
+	}
+	if ((rd(gicd, GICD_IGROUPR + GPU_INT_WORD) & GPU_INT_BIT) == 0) {
+		LOG("0419: SPI 177 is Group 0 in the distributor (TrustZone's): the fence interrupt is not armed");
+		return false;
+	}
+	sweet_spi_hook = gpu_spi;
+	gwr(REG_RBBM_INT_0_MASK, 0);
+	gwr(REG_RBBM_INT_CLEAR_CMD, 0xFFFFFFFF);
+	wr(gicd, GICD_ICENABLER + GPU_INT_WORD, GPU_INT_BIT);
+	wr(gicd, GICD_ICPENDR + GPU_INT_WORD, GPU_INT_BIT);
+	*(volatile uint8_t *)(gicd + GICD_IPRIORITYR + GPU_INTID) = 0xA0;       /* as pe_fiq.c gives the SGIs and PPIs */
+	rmw(gicd, GICD_ICFGR + 4u * (GPU_INTID / 16u), 2u << (2u * (GPU_INTID % 16u)), 0);      /* level */
+	gmb();
+	*(volatile uint64_t *)(gicd + GICD_IROUTER + 8u * GPU_INTID) = gpu_irq_mpidr & 0xFF00FFFFFFull;  /* Aff3..0, IRM 0 */
+	gmb();
+	girq.empty_run = 0;
+	girq.broken = false;
+	girq_armed = 1;
+	gwr(REG_RBBM_INT_0_MASK, RBBM_INT_CACHE_FLUSH_TS);
+	wr(gicd, GICD_ISENABLER + GPU_INT_WORD, GPU_INT_BIT);
+	girq.arms++;
+	LOG("0419: fence interrupt armed: SPI 177 to MPIDR %llx, RBBM_INT_0_MASK %08x", gpu_irq_mpidr,
+	    grd(REG_RBBM_INT_0_MASK));
+	gic_report("0419: armed");
+	return true;
+}
+
+/* 0419: and let it go. service_lock held. */
+static void
+girq_disarm(void)
+{
+	if (!girq_armed && !girq.broken) {
+		return;
+	}
+	girq_armed = 0;
+	if (gpu != NULL) {
+		gwr(REG_RBBM_INT_0_MASK, 0);
+		gwr(REG_RBBM_INT_CLEAR_CMD, 0xFFFFFFFF);
+	}
+	if (gicd != NULL) {
+		wr(gicd, GICD_ICENABLER + GPU_INT_WORD, GPU_INT_BIT);
+		wr(gicd, GICD_ICPENDR + GPU_INT_WORD, GPU_INT_BIT);
+	}
+	girq.disarms++;
+	thread_wakeup((event_t)&girq_fence_event);  /* whoever sleeps for it looks again, the other way */
+}
+
+extern "C" bool sapphire_gpu_fence_irq(void);
+extern "C" void sapphire_gpu_fence_listener(void *event);
+
+/* 0420: whether fences wake their waiters (the frame queue then looks less often) */
+bool
+sapphire_gpu_fence_irq(void)
+{
+	return girq_armed != 0 && gpu_wait_mode == 2;
+}
+
+/* 0420: one event that every fence interrupt wakes as well (NULL: none) */
+void
+sapphire_gpu_fence_listener(void *event)
+{
+	girq_listener = (event_t)event;
+}
+
+static uint64_t
+gpu_wait_abs(int us, int lo, int hi)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)(us < lo ? lo : us > hi ? hi : us) * NSEC_PER_USEC, &abs);
+	return abs;
+}
+
 /* Wait for fence f, without the service lock, up to ms; false if it never came. */
 static bool
 msm_wait(uint32_t f, uint64_t ms)
@@ -5774,6 +5960,7 @@ msm_wait(uint32_t f, uint64_t ms)
 		return false;
 	}
 	uint64_t diag_t0 = mach_absolute_time();
+	uint32_t step_us = 50;                      /* 0419: kern.sweet_gpu_wait=1 */
 	clock_interval_to_deadline((uint32_t)ms, kMillisecondScale, &deadline);
 	while (!msm_fence_done(f)) {
 		now = mach_absolute_time();
@@ -5790,12 +5977,83 @@ msm_wait(uint32_t f, uint64_t ms)
 			return false;
 		}
 		OSAddAtomic64(1, (volatile SInt64 *)&gdiag.wait_loops);
-		delay_for_interval(50, NSEC_PER_USEC);
+		int mode = gpu_wait_mode;
+		if (mode == 2 && girq_armed) {
+			uint64_t until = now + gpu_wait_abs(gpu_wait_irq_us, 100, 100000);
+			(void)assert_wait_deadline((event_t)&girq_fence_event, THREAD_UNINT, until < deadline ? until : deadline);
+			if (msm_fence_done(f) || !girq_armed) {
+				(void)clear_wait(current_thread(), THREAD_AWAKENED);    /* written before the wait was asserted */
+				continue;
+			}
+			if (thread_block(THREAD_CONTINUE_NULL) == THREAD_TIMED_OUT) {
+				OSAddAtomic64(1, (volatile SInt64 *)&girq.wake_net);
+			} else {
+				OSAddAtomic64(1, (volatile SInt64 *)&girq.wake_irq);
+			}
+		} else if (mode != 0) {
+			delay_for_interval_with_leeway(step_us, step_us / 8, NSEC_PER_USEC);
+			uint32_t cap = (uint32_t)(gpu_wait_max_us < 50 ? 50 : gpu_wait_max_us > 8000 ? 8000 : gpu_wait_max_us);
+			step_us = step_us * 2 > cap ? cap : step_us * 2;
+		} else {
+			delay_for_interval(50, NSEC_PER_USEC);
+		}
 	}
 	gdiag_since(&gdiag.wait, diag_t0);
 	return true;
 }
 
+/* 0419: read, the mode; write 0, 1 or 2, now. 2 arms the fence interrupt (1 if it cannot be armed), 0 and 1 disarm it. */
+static int
+sweet_gpu_wait_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = gpu_wait_mode;
+	int error;
+
+	error = sysctl_io_number(req, v, sizeof(v), &v, NULL);
+	if (error != 0 || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (v < 0 || v > 2) {
+		return EINVAL;
+	}
+	if (service_lock == NULL || !service_ready) {
+		gpu_wait_mode = v;                      /* taken at the service's start */
+		return 0;
+	}
+	IOLockLock(service_lock);
+	bool armed = v == 2 ? girq_arm() : (girq_disarm(), false);
+	gpu_wait_mode = v;
+	IOLockUnlock(service_lock);
+	LOG("0419: kern.sweet_gpu_wait=%d%s", v, v == 2 && !armed ? " (the interrupt could not be armed: back-off)" : "");
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_gpu_wait, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    NULL, 0, sweet_gpu_wait_sysctl, "I", "sapphire 0419: how fences are waited for: 0 = 50 us sleeps (as before), 1 = back-off, 2 = the GPU's interrupt");
+SYSCTL_INT(_kern, OID_AUTO, sweet_gpu_wait_max_us, CTLFLAG_RW | CTLFLAG_LOCKED, &gpu_wait_max_us, 0,
+    "sapphire 0419: the back-off's longest sleep (50-8000 us)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_gpu_wait_irq_us, CTLFLAG_RW | CTLFLAG_LOCKED, &gpu_wait_irq_us, 0,
+    "sapphire 0419: with the interrupt, how long a waiter sleeps at most before it looks anyway (100-100000 us)");
+SYSCTL_QUAD(_kern, OID_AUTO, sweet_gpu_irq_mpidr, CTLFLAG_RW | CTLFLAG_LOCKED, &gpu_irq_mpidr,
+    "sapphire 0419: the CPU (MPIDR) the GPU's interrupt is sent to, from the next arming; 0 = the first A53");
+
+static int
+sweet_gpu_irq_stats_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char line[384];
+
+	snprintf(line, sizeof(line), "fence wait (kern.sweet_gpu_wait %d, max %d us, net %d us): interrupt %s%s; "
+	    "interrupts %llu (CACHE_FLUSH_TS %llu, other bits %llu, empty %llu, stray %llu, last status %08x); "
+	    "waits woken by it %llu, by the net %llu; armed %llu times, disarmed %llu; wait loops %llu in %llu waits\n",
+	    gpu_wait_mode, gpu_wait_max_us, gpu_wait_irq_us, girq_armed ? "armed" : "off", girq.broken ? " (broken)" : "",
+	    girq.irqs, girq.ts, girq.other, girq.empty, girq.stray, girq.last_status, girq.wake_irq, girq.wake_net,
+	    girq.arms, girq.disarms, gdiag.wait_loops, gdiag.wait_n);
+	return SYSCTL_OUT(req, line, strlen(line) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_gpu_irq_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    NULL, 0, sweet_gpu_irq_stats_sysctl, "A", "sapphire 0419: the GPU's fence interrupt and the waits");
+
 /* How long from now a time of msm's is (CLOCK_MONOTONIC = mach_continuous_time here), in ms; at most 2 s. */
 static uint64_t
 msm_ms_until(const struct msm_timespec *when)
@@ -5869,6 +6127,11 @@ gpu_recover(void)
 	*(volatile uint32_t *)(pool + OFF_MSM_FENCE) = msm_seq;
 	*(volatile uint32_t *)(pool + OFF_FENCE) = fence_seq;
 	gmb();
+	if (girq_armed) {
+		gwr(REG_RBBM_INT_CLEAR_CMD, 0xFFFFFFFF);    /* 0419: the reset cleared the mask */
+		gwr(REG_RBBM_INT_0_MASK, RBBM_INT_CACHE_FLUSH_TS);
+	}
+	thread_wakeup((event_t)&girq_fence_event);  /* 0419: every wait ends now (the fences jumped) */
 	smmu_fault("msm: recover");
 	return true;
 }
@@ -7338,7 +7601,7 @@ SapphireGPUClient::submitIt(struct msm_gem_submit *r)
 			gdiag_mark(POOL_PA + OFF_DIAG + mark * 16u + 8);        /* all of it drawn */
 		}
 		emit(pkt7(CP_EVENT_WRITE, 4));          /* CACHE_FLUSH_TS into the msm slot (event() writes the shared one) */
-		emit(EV_CACHE_FLUSH_TS);                /* (not TIMESTAMP: see event()) */
+		emit(EV_CACHE_FLUSH_TS | (girq_armed ? CP_EVENT_IRQ : 0));      /* (not TIMESTAMP: see event()); 0419: IRQ */
 		emit((uint32_t)(POOL_PA + OFF_MSM_FENCE));
 		emit((uint32_t)((POOL_PA + OFF_MSM_FENCE) >> 32));
 		emit(++msm_seq);
