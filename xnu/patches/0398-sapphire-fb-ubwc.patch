+
+/* The first row whose rate is not under khz (a DDR rate: kern.sweet_ddr_floor and _cap); the top row above all. */
+static unsigned
+ddr_row_of_rate(uint32_t khz)
+{
+	for (unsigned i = 0; i < DDR_ROWS; i++) {
+		if (ddr_row_khz[i] >= khz) {
+			return i;
+		}
+	}
+	return DDR_ROWS - 1;
