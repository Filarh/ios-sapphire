+	if (lv[target] == opp_khz) {
+		return true;
+	}
+	int e = gpu_opp_set(lv[target], NULL);
+	if (e == 0) {
+		if (target == 0 && gstate.idle_ms != 0) {
+			ggov.idle_drops++;
+		} else if (lv[target] > opp_khz || target > cur) {
+			ggov.up++;
+		} else {
