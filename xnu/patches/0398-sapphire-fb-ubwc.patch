+SYSCTL_PROC(_kern, OID_AUTO, sweet_ddr_khz, CTLTYPE_INT | CTLFLAG_RD | CTLFLAG_LOCKED,
+    NULL, 0, sweet_ddr_khz_sysctl, "I", "sapphire 0343: the DDR's clock in kHz, from the memory controller's period register");
