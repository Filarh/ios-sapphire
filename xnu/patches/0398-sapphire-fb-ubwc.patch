+/* The ladder the governor moves on, lowest first; its length. */
+static unsigned
+gov_ladder(uint32_t *lv)
+{
+	uint32_t top = gov_khz_max > 0 ? (uint32_t)gov_khz_max : gov_boot_khz, low = (uint32_t)MAX(gov_khz_min, 320000);
