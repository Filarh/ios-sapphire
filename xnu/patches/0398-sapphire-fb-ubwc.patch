+	}
+	ddr_in_gpu = khz == RPM_RATE_MAX ? 0 : khz;
+	uint64_t votes = gbus.votes;
+	ddr_apply(false);
+	int e = gbus.votes != votes ? gbus.last_err : 0;
+	IOLockUnlock(l);
+	return e;
