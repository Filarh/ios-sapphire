+{
+	uint32_t in = MAX(ddr_in_gpu, ddr_in_cpu);
+	unsigned r = MAX(in != 0 ? ddr_row_for(in) : 0u, ddr_row_of_rate((uint32_t)MAX(ddr_floor, 0)));
+
+	r = MIN(r, ddr_row_of_rate((uint32_t)MAX(ddr_cap, 0)));
+	if (ddr_hot) {
+		r = MIN(r, ddr_boot_row);
+	}
+	return r;
+}
