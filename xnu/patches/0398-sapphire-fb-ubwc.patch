+		(void)ddr_vote_row(r);
+	} else if (r < ddr_row) {
+		if (ddr_low_since == 0) {
+			ddr_low_since = now;
+		}
+		if (bus_ns(now - ddr_low_since) >= (uint64_t)MAX(ddr_down_ms, 0) * NSEC_PER_MSEC || (!tick && ddr_down_ms == 0)) {
+			ddr_low_since = 0;
+			(void)ddr_vote_row(r);
+		}
+	} else {
+		ddr_low_since = 0;
+	}
