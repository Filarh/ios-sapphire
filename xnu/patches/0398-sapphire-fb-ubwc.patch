+SYSCTL_PROC(_kern, OID_AUTO, sweet_bus_clocks, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    NULL, 0, sweet_bus_clocks_sysctl, "A", "sapphire 0361: the RPM's buses and the DDR, measured at the read");
