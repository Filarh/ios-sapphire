diff --git a/bsd/dev/sweet_pace.c b/bsd/dev/sweet_pace.c
new file mode 100644
index 0000000..39524fb
--- /dev/null
+++ b/bsd/dev/sweet_pace.c
@@ -0,0 +1,269 @@
+/*
+ * sapphire 0421: the pace of the kernel's polling threads.
+ *
+ * The port takes no device interrupt but the GPU's (0419): the modem and WLAN (modem_watch), the ADSP and audio
+ * (adsp_thread), FastRPC, the USB controller, the touch panel, the keys and en0's thread look at their hardware
+ * from kernel threads of priority 81 that sleep 1-20 ms between looks. Report 16 §3.2 and §5.3 measure ~3600-4100
+ * wakeups a second of such threads on the A73s, four of them every ~1.2 ms (IOSleep(1)), each a possible preemption
+ * of backboardd's render thread (61-112 a second) and a migration between A73s (66-105 a second).
+ *
+ * kern.sweet_pace (boot-arg sweet_pace), 0 by default: everything exactly as before. With 1:
+ *   - every sleep of these threads carries kern.sweet_pace_leeway_pct (25) % of its period as leeway (at most
+ *     2 ms; TIMEOUT_URGENCY_LEEWAY), so their timers can fire together and the CPUs leave idle less often;
+ *   - the 1 ms loops (modem_watch, adsp_thread) sleep kern.sweet_pace_idle_ms (4; one of 1, 2, 4, 5, 8, 10, 20:
+ *     divisors of 1000, so the loops' own millisecond counters still meet their "ms % 1000 == 0" marks) once
+ *     nothing has moved for kern.sweet_pace_hold_ms (200), and 1 ms again as soon as something moves. Their
+ *     counters count loops, not time, as they did (IOSleep(1) lasts ~1.2 ms): a long sleep adds its milliseconds.
+ *     Before the counter reaches 60000 (the boot's own timed steps: the audio test at 45 s, the logs at 3, 5, 20,
+ *     30 and 44 s) they keep 1 ms. Sending on WLAN or IPA wakes the modem loop at once (sweet_pace_kick);
+ *   - the USB controller's thread sleeps kern.sweet_pace_usb_idle_us (4000) instead of 1 ms when no frame moved in
+ *     the last 10 ms (sending wakes it, as before; a frame from the host waits that long at most);
+ *   - the threads in kern.sweet_pace_ecore (bit per thread below; all by default) are soft-bound to the A53
+ *     cluster (thread_bind_cluster_type 'E', soft: they may still run on an A73 when the A53s are busy), where the
+ *     render thread never runs (16 §2), so they stop preempting it. Each thread rebinds itself at its next sleep
+ *     after a change.
+ * The threads are named (thread_set_thread_name) whatever the mode, for kdebug and thrsched:
+ *   bit 0 "sweet modem", 1 "sweet adsp", 2 "sweet usb", 3 "sweet touch", 4 "sweet net", 5 "sweet keys",
+ *   6 "sweet frpc".
+ * kern.sweet_pace_stats: per thread, the sleeps, the long (idle) ones, the wakeups by a kick, the binding.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+#define SWEET_PACE_N    7
+
+extern void sweet_pace_start(int who, const char *name);
+extern unsigned sweet_pace_step(int who, uint64_t activity, unsigned clock_ms);
+extern void sweet_pace_sleep_ms(int who, unsigned ms, void *chan);
+extern void sweet_pace_kick(int who, void *chan);
+extern uint64_t sweet_pace_leeway(int who, uint64_t period_abs);
+extern wait_result_t sweet_pace_assert(int who, void *chan, uint64_t deadline, uint64_t period_abs);
+extern uint64_t sweet_pace_usb_idle_abs(uint64_t dflt);
+
+static int sweet_pace;
+static int sweet_pace_leeway_pct = 25;
+static int sweet_pace_idle_ms = 4;
+static int sweet_pace_hold_ms = 200;
+static int sweet_pace_usb_idle_us = 4000;
+static int sweet_pace_ecore = (1 << SWEET_PACE_N) - 1;
+static volatile uint32_t sweet_pace_gen = 1;             /* changes with kern.sweet_pace and kern.sweet_pace_ecore */
+static bool sweet_pace_args;
+
+static struct sweet_pacer {
+	const char *name;
+	uint64_t sleeps, idle_sleeps, kicks;
+	uint64_t last_act, act_abs;                 /* the activity count last seen, and when it last moved */
+	uint32_t gen;                               /* the binding applied for this sweet_pace_gen */
+	bool started, ecore, kicked;
+} pacers[SWEET_PACE_N];
+
+static void
+sweet_pace_boot_args(void)
+{
+	if (!sweet_pace_args) {
+		sweet_pace_args = true;
+		(void)PE_parse_boot_argn("sweet_pace", &sweet_pace, sizeof(sweet_pace));
+	}
+}
+
+static struct sweet_pacer *
+pacer(int who)
+{
+	return who >= 0 && who < SWEET_PACE_N ? &pacers[who] : NULL;
+}
+
+/* In the thread, at its start and before each sleep: its name once, its cluster when the settings changed. */
+static void
+sweet_pace_bind(struct sweet_pacer *p, int who)
+{
+	uint32_t gen = __atomic_load_n(&sweet_pace_gen, __ATOMIC_RELAXED);
+	if (p->gen == gen) {
+		return;
+	}
+	p->gen = gen;
+	bool e = sweet_pace != 0 && (sweet_pace_ecore & (1 << who)) != 0;
+	if (e != p->ecore) {
+		p->ecore = e;
+		thread_bind_cluster_type(current_thread(), e ? 'E' : '-', e);   /* soft to E; '-': no binding */
+	}
+}
+
+void
+sweet_pace_start(int who, const char *name)
+{
+	struct sweet_pacer *p = pacer(who);
+
+	sweet_pace_boot_args();
+	if (p == NULL) {
+		return;
+	}
+	p->name = name;
+	p->started = true;
+	p->gen = 0;
+	thread_set_thread_name(current_thread(), name);
+	sweet_pace_bind(p, who);
+}
+
+uint64_t
+sweet_pace_leeway(int who, uint64_t period_abs)
+{
+	uint64_t cap;
+
+	(void)who;
+	if (sweet_pace == 0 || sweet_pace_leeway_pct <= 0) {
+		return 0;
+	}
+	nanoseconds_to_absolutetime(2 * NSEC_PER_MSEC, &cap);
+	uint64_t l = period_abs / 100 * (uint64_t)(sweet_pace_leeway_pct > 100 ? 100 : sweet_pace_leeway_pct);
+	return l > cap ? cap : l;
+}
+
+/* How many milliseconds a 1 ms loop sleeps now, and adds to its counter clock_ms: 1, or the idle period. */
+unsigned
+sweet_pace_step(int who, uint64_t activity, unsigned clock_ms)
+{
+	struct sweet_pacer *p = pacer(who);
+	uint64_t now = mach_absolute_time(), hold;
+
+	if (p == NULL) {
+		return 1;
+	}
+	if (activity != p->last_act || p->kicked) {
+		p->last_act = activity;
+		p->act_abs = now;
+		p->kicked = false;
+	}
+	int idle = sweet_pace_idle_ms;
+	if (idle != 1 && idle != 2 && idle != 4 && idle != 5 && idle != 8 && idle != 10 && idle != 20) {
+		idle = 4;
+	}
+	nanoseconds_to_absolutetime((uint64_t)(sweet_pace_hold_ms < 0 ? 0 : sweet_pace_hold_ms) * NSEC_PER_MSEC, &hold);
+	if (sweet_pace == 0 || idle == 1 || clock_ms < 60000 || now - p->act_abs < hold) {
+		return 1;
+	}
+	return (unsigned)idle - clock_ms % (unsigned)idle;      /* to the next multiple of the period */
+}
+
+/* Assert a wait on chan until deadline, with the leeway of a sleep of period_abs. */
+wait_result_t
+sweet_pace_assert(int who, void *chan, uint64_t deadline, uint64_t period_abs)
+{
+	struct sweet_pacer *p = pacer(who);
+	uint64_t leeway = sweet_pace_leeway(who, period_abs);
+
+	if (p != NULL) {
+		sweet_pace_bind(p, who);
+		p->sleeps++;
+	}
+	if (leeway == 0) {
+		return assert_wait_deadline((event_t)chan, THREAD_UNINT, deadline);
+	}
+	return assert_wait_deadline_with_leeway((event_t)chan, THREAD_UNINT, TIMEOUT_URGENCY_LEEWAY, deadline, leeway);
+}
+
+/* The 1 ms loops' sleep: ms milliseconds on chan (NULL: not to be kicked), with leeway. */
+void
+sweet_pace_sleep_ms(int who, unsigned ms, void *chan)
+{
+	struct sweet_pacer *p = pacer(who);
+	uint64_t period, deadline;
+
+	if (sweet_pace == 0 && chan == NULL) {
+		if (p != NULL) {
+			sweet_pace_bind(p, who);
+			p->sleeps++;
+		}
+		delay_for_interval(ms, NSEC_PER_MSEC);  /* exactly as before (IOSleep) */
+		return;
+	}
+	if (p != NULL && ms > 1) {
+		p->idle_sleeps++;
+	}
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &period);
+	deadline = mach_absolute_time() + period;
+	(void)sweet_pace_assert(who, chan != NULL ? chan : (void *)&pacers[0], deadline, period);
+	if (thread_block(THREAD_CONTINUE_NULL) == THREAD_AWAKENED && p != NULL) {
+		p->kicks++;
+	}
+}
+
+/* Something for the loop to do: wake it now, and count it as activity. */
+void
+sweet_pace_kick(int who, void *chan)
+{
+	struct sweet_pacer *p = pacer(who);
+
+	if (p == NULL || sweet_pace == 0) {
+		return;
+	}
+	p->kicked = true;
+	thread_wakeup((event_t)chan);
+}
+
+/* The USB controller's sleep with no frame moved in the last 10 ms. */
+uint64_t
+sweet_pace_usb_idle_abs(uint64_t dflt)
+{
+	uint64_t abs;
+
+	if (sweet_pace == 0) {
+		return dflt;
+	}
+	int us = sweet_pace_usb_idle_us < 1000 ? 1000 : sweet_pace_usb_idle_us > 20000 ? 20000 : sweet_pace_usb_idle_us;
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &abs);
+	return abs;
+}
+
+static int
+sweet_pace_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg2)
+	int *v = (int *)arg1;
+	int n = *v;
+	int error = sysctl_io_number(req, n, sizeof(n), &n, NULL);
+	if (error != 0 || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	*v = n;
+	(void)__atomic_add_fetch(&sweet_pace_gen, 1, __ATOMIC_RELAXED);   /* each thread rebinds itself at its next sleep */
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_pace, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    &sweet_pace, 0, sweet_pace_sysctl, "I", "sapphire 0421: 1 = the polling threads' leeway, idle periods and A53 binding; 0 = as before");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_pace_ecore, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    &sweet_pace_ecore, 0, sweet_pace_sysctl, "I", "sapphire 0421: the polling threads soft-bound to the A53s, a bit each (see kern.sweet_pace_stats)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_pace_leeway_pct, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_pace_leeway_pct, 0,
+    "sapphire 0421: leeway of each sleep, % of its period (at most 2 ms)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_pace_idle_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_pace_idle_ms, 0,
+    "sapphire 0421: period of the 1 ms loops (modem, adsp) with nothing moving: 1, 2, 4, 5, 8, 10 or 20");
+SYSCTL_INT(_kern, OID_AUTO, sweet_pace_hold_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_pace_hold_ms, 0,
+    "sapphire 0421: how long after the last activity the 1 ms loops keep 1 ms");
+SYSCTL_INT(_kern, OID_AUTO, sweet_pace_usb_idle_us, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_pace_usb_idle_us, 0,
+    "sapphire 0421: the USB controller thread's sleep with no traffic (1000-20000 us)");
+
+static int
+sweet_pace_stats_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char out[1024];
+	size_t o = 0;
+
+	o += (size_t)snprintf(out + o, sizeof(out) - o, "pace %d (leeway %d %%, idle %d ms, hold %d ms, usb idle %d us, ecore %#x)\n",
+	    sweet_pace, sweet_pace_leeway_pct, sweet_pace_idle_ms, sweet_pace_hold_ms, sweet_pace_usb_idle_us, sweet_pace_ecore);
+	for (int i = 0; i < SWEET_PACE_N && o < sizeof(out); i++) {
+		struct sweet_pacer *p = &pacers[i];
+		if (!p->started) {
+			continue;
+		}
+		o += (size_t)snprintf(out + o, sizeof(out) - o, "%d %s: sleeps %llu, idle %llu, kicked %llu, %s\n", i, p->name,
+		    p->sleeps, p->idle_sleeps, p->kicks, p->ecore ? "A53" : "any");
+	}
+	return SYSCTL_OUT(req, out, strlen(out) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_pace_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    NULL, 0, sweet_pace_stats_sysctl, "A", "sapphire 0421: the polling threads");
