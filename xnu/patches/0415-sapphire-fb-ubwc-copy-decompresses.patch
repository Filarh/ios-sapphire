+/*
+ * sapphire 0415: blit_scale() from a surface in the kernel's UBWC layout (SweetSurface.cpp, sweet_pool_ubwc_layout(): flag
+ * buffer at meta, TILE6_3 data at data). The 2D engine reads it as Turnip's r2d_src does over a UBWC view
+ * (tu_clear_blit.cc; fdl6_view_init's SP_PS_2D_SRC_INFO): TILE6_3, FLAGS, the flag buffer and its pitch in
+ * SP_PS_2D_SRC_FLAGS, and WZYX, the order a tiled layout keeps every 8-bit format in. The destination's WXYZ (the swap of
+ * B8G8R8A8, fd6_format_table.c) puts the window server's B,G,R,A back into the flip buffer, which the plane scans as
+ * BGRA. A tiled source cannot be cropped by its address as blit_scale() does: the base stays the data's start and the
+ * whole rectangle goes into GRAS_A2D_SRC_*.
+ */
+static bool
+blit_scale_ubwc(uint64_t data, uint32_t dpitch_src, uint64_t meta, uint32_t mpitch, uint32_t width, uint32_t height,
+    uint32_t sx, uint32_t sy, uint32_t sw, uint32_t sh, uint64_t dst, uint32_t dpitch, uint32_t dw, uint32_t dh)
+{
+	uint32_t k = (dpitch & 63) == 0 ? 1 : 2;
+
+	if ((dpitch_src & 63) != 0 || (mpitch & 63) != 0 || (mpitch >> 6) > 0xff || (data & 4095) != 0 || (meta & 63) != 0 ||
+	    ((k * dpitch) & 63) != 0 || (dst & 3) != 0 || dw == 0 || dh == 0 || sw == 0 || sh == 0 || width == 0 || height == 0 ||
+	    width > 0x7fff || height > 0x7fff || dw + 16 > 0x4000 || ((sx + sw) >> 8) > width || ((sy + sh) >> 8) > height) {
+		LOG("  blit_scale_ubwc: pitches %u/%u/%u or sizes do not fit the blitter", dpitch_src, mpitch, dpitch);
+		return false;
+	}
+	blit_setup(false, 0);
+	for (uint32_t j = 0; j < k && j < dh; j++) {
+		uint64_t d0 = dst + (uint64_t)j * dpitch;
+		uint32_t dx = (uint32_t)(d0 & 63) / 4, n = (dh - j + k - 1) / k;
+		int64_t span = (int64_t)sh * k * n / dh;
+		int64_t y0 = (int64_t)sy + ((2 * (int64_t)j + 1 - (int64_t)k) * (int64_t)sh) / (2 * (int64_t)dh);
+		if (y0 < 0) {
+			y0 = 0;
+		}
+		emit(pkt4(REG_TPL1_A2D_SRC_TEXTURE_INFO, 5));        /* INFO, SIZE, BASE lo/hi, PITCH */
+		emit(FMT6_8_8_8_8_UNORM | (3u << 8) | (1u << 12) | (1u << 16) | (1u << 20) | (1u << 22));  /* TILE6_3, WZYX, FLAGS, FILTER */
+		emit(width | (height << 15));
+		emit((uint32_t)data);
+		emit((uint32_t)(data >> 32));
+		emit((dpitch_src >> 6) << 9);
+		emit(pkt4(REG_SP_PS_2D_SRC_FLAGS, 3));                 /* FLAGS lo/hi, FLAGS_PITCH (64-byte units) */
+		emit((uint32_t)meta);
+		emit((uint32_t)(meta >> 32));
+		emit(mpitch >> 6);
+		emit(pkt4(REG_GRAS_A2D_SRC_XMIN, 4));
+		emit(sx);
+		emit(sx + sw - 256);
+		emit((uint32_t)y0);
+		emit((uint32_t)(y0 + span - 256));
+		blit_rect(d0 & ~63ull, k * dpitch, dx, 0, dx + dw - 1, n - 1, 1 /* WXYZ */);
+	}
+	/* the next linear copy must not find the flag buffer on: blit_copy() and blit_scale() leave FLAGS clear in INFO */
+	return blit_end("scale-ubwc");
+}
