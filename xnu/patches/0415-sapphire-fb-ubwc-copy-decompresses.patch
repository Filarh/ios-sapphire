+bool sapphire_gpu_copy_scaled_ubwc(IOMemoryDescriptor *src, uint64_t data_off, uint32_t data_pitch, uint64_t meta_off,
+    uint32_t meta_pitch, uint32_t width, uint32_t height, uint32_t sx, uint32_t sy, uint32_t sw, uint32_t sh, uint64_t dst_pa,
+    uint32_t dst_pitch, uint32_t dw, uint32_t dh, uint64_t dst_base, uint64_t dst_size);
+
+bool
+sapphire_gpu_copy_scaled_ubwc(IOMemoryDescriptor *src, uint64_t data_off, uint32_t data_pitch, uint64_t meta_off,
+    uint32_t meta_pitch, uint32_t width, uint32_t height, uint32_t sx, uint32_t sy, uint32_t sw, uint32_t sh, uint64_t dst_pa,
+    uint32_t dst_pitch, uint32_t dw, uint32_t dh, uint64_t dst_base, uint64_t dst_size)
+{
+	static uint32_t told;
+	bool ok = false;
+	uint64_t last = data_off + (uint64_t)((height + 15) & ~15u) * data_pitch;
+
+	if (!service_ready || src == NULL || dw == 0 || dh == 0) {
+		return false;
+	}
+	uint64_t diag_t0 = mach_absolute_time();
+	IOLockLock(service_lock);
+	gdiag_since(&gdiag.copy_lock, diag_t0);
+	if (service_ready) {
+		uint64_t va = map_window(src);
+		bool dst_ok = map_identity(dst_base, dst_size);
+		if (!ring_room(1024, 200)) {
+			LOG("service: the ring stays full (the GPU stopped?): copy refused");
+			IOLockUnlock(service_lock);
+			return false;
+		}
+		if (va != 0 && dst_ok && last <= src->getLength() && meta_off < data_off) {
+			uint32_t mark = gdiag_copy_begin();
+			ok = blit_scale_ubwc(va + data_off, data_pitch, va + meta_off, meta_pitch, width, height, sx, sy, sw, sh, dst_pa,
+			    dst_pitch, dw, dh);
+			gdiag_copy_end(mark);
+			uint32_t wi = (uint32_t)((va - WIN_BASE) / WIN_SIZE);
+			if (wi < WIN_COUNT) {
+				win[wi].fence = fence_seq;
+			}
+			last_copy_fence = fence_seq;
+			if (!ok && told++ < 4) {
+				/* refused before anything was emitted (blit_scale_ubwc() checks first): the GPU path stays on */
+				LOG("service: a UBWC copy was refused (%ux%u, data pitch %u, meta pitch %u)", width, height, data_pitch,
+				    meta_pitch);
+			}
+		} else if (told++ < 4) {
+			LOG("service: cannot map this UBWC copy (window %llx, destination %s, %ux%u of %llu bytes)", va,
+			    dst_ok ? "ok" : "NOT mapped", width, height, src->getLength());
+		}
+	}
+	IOLockUnlock(service_lock);
+	return ok;
+}
