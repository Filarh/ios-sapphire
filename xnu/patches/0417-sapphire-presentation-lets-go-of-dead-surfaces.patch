+/* service_lock held */
+static void
+msm_reap_arm(void)
+{
+	uint64_t deadline;
+
+	if (msm_reap_call == NULL || msm_reap_armed) {
+		return;
+	}
+	clock_interval_to_deadline(MSM_REAP_MS, kMillisecondScale, &deadline);
+	msm_reap_armed = true;
+	(void)thread_call_enter_delayed(msm_reap_call, deadline);
