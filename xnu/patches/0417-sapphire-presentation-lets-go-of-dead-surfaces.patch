+
+/* every client's buffers left whose fence is done are freed; how many of surfaces were, in *freed. service_lock held. */
+static uint32_t
+msm_reap_all_locked(uint64_t *freed)
+{
+	uint64_t before = gleft.reaped;
+	uint32_t waiting = 0;
+
+	for (uint32_t i = 0; i < MSM_CLIENTS; i++) {
+		if (msm_clients[i] != NULL) {
+			waiting += msm_clients[i]->reap();
+		}
+	}
+	gleft.waiting = waiting;
+	if (freed != NULL) {
+		*freed += gleft.reaped - before;
+	}
+	return waiting;
+}
+
+static void
+msm_reap_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	if (service_lock == NULL) {
+		return;
+	}
+	IOLockLock(service_lock);
+	msm_reap_armed = false;
+	gleft.ticks++;
+	if (msm_reap_all_locked(&gleft.by_timer) != 0) {
+		msm_reap_arm();                 /* (a GPU that hangs is reset after 2 s, and its fences jump: 0317) */
+	}
+	IOLockUnlock(service_lock);
+}
+
+/* service_lock held */
+static void
+msm_client_forget_locked(SapphireGPUClient *c)
+{
+	for (uint32_t i = 0; i < MSM_CLIENTS; i++) {
+		if (msm_clients[i] == c) {
+			msm_clients[i] = NULL;
+		}
+	}
+}
+
+/*
+ * 0417: every client reaped now (why: 0 the scanout pool is full, 1 its census is read); the buffers of surfaces freed.
+ * Takes service_lock: the caller holds neither it nor the surface table's lock (a surface freed here takes that one).
+ */
+extern "C" uint32_t sapphire_gpu_reap_all(int why);
+
+extern "C" uint32_t
+sapphire_gpu_reap_all(int why)
+{
+	uint64_t freed = 0;
+
+	if (service_lock == NULL) {
+		return 0;
+	}
+	IOLockLock(service_lock);
+	(void)msm_reap_all_locked(&freed);
+	if (why == 0) {
+		gleft.by_pool += freed;
+	} else {
+		gleft.by_query += freed;
+	}
+	IOLockUnlock(service_lock);
+	return (uint32_t)freed;
+}
