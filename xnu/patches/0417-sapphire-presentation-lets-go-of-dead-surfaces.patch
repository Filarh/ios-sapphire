+/*
+ * sapphire 0417: a surface of the scanout pool has left the table (no program has it: SweetSurface.cpp,
+ * sweet_surface_put()), or the pool is full. From a thread call, the framebuffer lets go of what it holds of such
+ * surfaces and does not need:
+ *  - a swap recorded while the display is off (fPendHold): let go, and its layers out of the pending record, so that
+ *    "on" does not show a frame of a window server that has gone (it held a slot all the time the display was off);
+ *  - the frame on the panel (fScanShow), with the display on and nothing waiting in the queue: shown again by the copy
+ *    into a flip buffer, as scanoutStop() does. The panel keeps its picture, and the surface goes when the MDP has taken
+ *    that flip (scanoutRetire()), as every frame of a surface it leaves. Until then it is the one that kept a slot when
+ *    backboardd was restarted (removeClient() did nothing), up to the new one's first frame.
+ * Nothing the MDP may still read is let go: the frames left (fScanLeave) and those in the queue keep their rules.
+ */
+static struct {
+	uint64_t looks, pend, shown;
+} sweet_fbg;
+
+void
+AppleCLCD::goneWork(thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	((AppleCLCD *)p0)->surfacesGone();
+}
+
+void
+AppleCLCD::surfacesGone(void)
+{
+	SweetSurface *drop[4] = {};
+	bool any = false;
+
+	sweet_fbg.looks++;
+	IOLockLock(fLock);
+	uint32_t mask = get32(fPending, 0x104);
+	for (uint32_t k = 0; k < 4 && k < SWEET_FB_LAYERS; k++) {
+		SweetSurface *s = fPendHold[k];
+		if (s == NULL || sweet_surface_alive(s->id, s)) {
+			continue;
+		}
+		drop[k] = s;
+		fPendHold[k] = NULL;
+		if (get32(fPending, 0x54 + 4 * k) == s->id) {
+			mask &= ~(1u << k);
+		}
+		any = true;
+		sweet_fbg.pend++;
+	}
+	if (any) {
+		bool left = false;
+		memcpy(fPending + 0x104, &mask, sizeof(mask));
+		for (uint32_t k = 0; k < SWEET_FB_LAYERS; k++) {
+			left |= (mask & (1u << k)) != 0 && get32(fPending, 0x54 + 4 * k) != 0;
+		}
+		if (!left) {
+			fDirty = false;         /* (nothing of it to show at "on": the new window server's first frame is) */
+		}
+	}
+	bool off = fPowerOff;
+	IOLockUnlock(fLock);
+	sweet_hold_set(drop, false);
+
+	if (off || fPresentLock == NULL || !fScale2) {
+		return;
+	}
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		return;
+	}
+	bzero(rec, SWEET_FB_SWAP_REC_SIZE);
+	IOLockLock(fPresentLock);
+	SweetSurface *gone = NULL;
+	for (uint32_t k = 0; k < 4 && gone == NULL; k++) {
+		if (fScanShow[k] != NULL && !sweet_surface_alive(fScanShow[k]->id, fScanShow[k])) {
+			gone = fScanShow[k];
+		}
+	}
+	if (gone != NULL && fQCount == 0 && queueOn() && !fPowerOff) {
+		/* one layer, the surface on the panel, no swap of its own (0353: swap 0); fScanShow keeps it until retired */
+		uint32_t one = 1, id = gone->id;
+		memcpy(rec + 0x104, &one, sizeof(one));
+		memcpy(rec + 0x54, &id, sizeof(id));
+		SweetSurface *none[4] = {};
+		bool queued = false;
+		fGoneShow = gone;
+		(void)presentQueued(rec, none, &queued);
+		fGoneShow = NULL;
+		sweet_fbg.shown++;
+	}
+	IOLockUnlock(fPresentLock);
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+}
