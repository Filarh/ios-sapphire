+/*
+ * 0410: the plane's linear registers as they were at its first UBWC flip (0403), and whether it is in UBWC now. The
+ * flip buffers of the copy path are linear: going back to them (planeUnscaled) must give these back too, or the panel
+ * decodes a linear buffer as UBWC (seen on the phone: SRC0 the flip buffer 0x5c000000, SRC_FORMAT 0x800237ff, lines).
+ */
+static bool sweet_ubwc_plane;
+static uint32_t sweet_ubwc_linear[7];             /* SRC2_ADDR, YSTRIDE1, FORMAT, UNPACK, OP_MODE, UBWC_STATIC_CTRL, FETCH */
+static const uint16_t sweet_ubwc_linear_off[7] = { 0x1c, 0x28, 0x30, 0x34, 0x38, 0x44, 0x48 };
+
 /* Back to the plane the bootloader set up (unscaled, the panel's size), before a flip of a flip buffer. */
 void
 AppleCLCD::planeUnscaled(void)
@@ -3272,6 +3281,12 @@ AppleCLCD::planeUnscaled(void)
 	for (unsigned k = 0; k < SWEET_PLANE_REGS; k++) {
 		fVig0[sweet_plane_off[k] / 4] = fPlane0[k];
