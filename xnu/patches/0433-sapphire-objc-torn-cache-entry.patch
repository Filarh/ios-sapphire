+		    sweet_objc_torn_entry(state, fault_addr)) {
+			return;
+		}
+#endif
+
 		codes[0] = result;
 	} else if (is_alignment_fault(fault_code)) {
 		kern_return_t vmfkr = KERN_SUCCESS;
