+/*
+ * 0424: COUNTRY_CODE (51), as Apple's driver answers it (dev-notes/investigacion/anexos/30-wifi/01-como-lo-hace-apple.md
+ * §2.4-2.5, §3.2): struct apple80211_country_code_data { u32 version; u8 cc[APPLE80211_MAX_CC_LEN]; } of the Mac OS X
+ * 10.5 SDK's apple80211_ioctl.h, APPLE80211_VERSION 1. A GET is always answered: the country in force, or "XZ" when
+ * there is none, which wifid takes for "no country, find one" (WiFiLocaleManager isDefaultCountryCode: X0, X2, X3, XZ);
+ * asked for 3 bytes it gets the code alone. A SET takes two letters; the third byte (802.11d's environment) is not
+ * looked at. A code beginning with X goes back to no country. The radio applies it (TopazModem.cpp) and, when the
+ * country in force changed, event 11 (APPLE80211_M_COUNTRY_CODE_CHANGED) tells wifid.
+ */
+#define COUNTRY_VERSION         1               /* APPLE80211_VERSION */
+#define COUNTRY_CC_LEN          3               /* APPLE80211_MAX_CC_LEN */
+#define COUNTRY_NONE            "XZ"            /* Apple's "no country" (the CLM's world aggregate) */
+#define COUNTRY_DEFAULT_PREFIX  'X'             /* X0, X2, X3, XZ: Apple's default codes */
+
+struct apple80211_country_code_data {
+	uint32_t version;
+	uint8_t cc[COUNTRY_CC_LEN];
+};
 
