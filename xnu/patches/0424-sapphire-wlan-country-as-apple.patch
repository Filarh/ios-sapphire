+static void
+w_cc_poll(void)
+{
+	if (w_cc_deadline != 0) {
+		if (g_ms > w_cc_deadline) {
+			w_cc_finish(ETIMEDOUT, "no REG_CHAN_LIST_CC from the firmware");
+		}
+		return;
+	}
+	if ((!w_cc_asked && !w_ch_refresh) || !wmi_ready || !scan_started || scanning || (s_state != S_IDLE && s_state != S_UP)) {
+		return;                                 /* (a scan or a join under way: after it) */
+	}
+	if (!w_cc_asked) {
+		w_ch_refresh = false;
+		if (w_cc[0] == 0) {                     /* (a country set since then has its own list) */
+			w_chans_board();
+			w_cc_leave_if_gone();
+			LOG("t=%u ms: country: none; channel list of the firmware's own rules %s", g_ms, w_send_chan_list() ? "sent" : "FAILED");
+			if (topaz_wlan_channels_hook != NULL) {
+				topaz_wlan_channels_hook();
+			}
+		}
+		return;
+	}
+	bool board = w_cc_want[0] == 0;
+	if (wmi_svc(SVC_REGULATORY_DB)) {
+		const char *a2 = board ? w_fw_cc : w_cc_want;
+		uint8_t v[4 + 8] = {};
+		if (a2[0] == 0) {
+			w_cc_finish(EIO, "the firmware has not said its own country");
+			return;
+		}
+		uint8_t *c = put32(wmi_put_tlv(v, TAG_SET_CURRENT_COUNTRY, 8), 0);      /* pdev 0 */
+		memcpy(c, a2, 2);                       /* new_alpha2: the code, then zeros */
+		if (!wmi_send(CMD_SET_CURRENT_COUNTRY, v, sizeof(v))) {
+			w_cc_finish(EIO, "SET_CURRENT_COUNTRY not sent");
+			return;
+		}
+		LOG("t=%u ms: country: SET_CURRENT_COUNTRY %c%c sent (the firmware has the regulatory database)", g_ms, a2[0], a2[1]);
+		w_cc_deadline = g_ms + W_CC_FW_WAIT_MS;
+		return;
+	}
+	struct wlan_rd_fw fw;
+	unsigned nr = 0;
+	const struct wlan_rd_rule *r = NULL;
+	if (board ? !(w_have_rd && wlan_rd_fw_for_board((uint16_t)w_eeprom_rd, &fw)) : !wlan_rd_fw_for_country(w_cc_want, &fw)) {
+		w_cc_finish(EINVAL, board ? "the board's eeprom_rd is not in qcacld's tables" : "not a country of qcacld's tables");
+		return;
+	}
+	if (!board && (r = wlan_rd_rules_of(w_cc_want, &nr)) == NULL) {
+		w_cc_finish(EINVAL, "no channel rules for it in qcacld's tables");
+		return;
+	}
+	if (board) {
+		w_chans_board();
+	} else {
+		(void)w_chans_from_rules(r, nr);
+	}
+	w_cc_leave_if_gone();
+	uint8_t v[4 + 28] = {};
+	uint8_t *c = put32(wmi_put_tlv(v, TAG_PDEV_SET_REGDOMAIN, 28), 0);         /* pdev 0 */
+	c = put32(c, fw.reg_domain);
+	c = put32(c, fw.dmn_2g);
+	c = put32(c, fw.dmn_5g);
+	c = put32(c, fw.ctl_2g);
+	c = put32(c, fw.ctl_5g);
+	(void)put32(c, 0);                          /* dfs_domain, 0 as qcacld sends it */
+	bool ok = wmi_send(CMD_PDEV_SET_REGDOMAIN, v, sizeof(v));
+	LOG("t=%u ms: country: PDEV_SET_REGDOMAIN regd %x 2g %x 5g %x ctl %x/%x %s", g_ms, fw.reg_domain, fw.dmn_2g, fw.dmn_5g,
+	    fw.ctl_2g, fw.ctl_5g, ok ? "sent" : "FAILED");
+	if (!ok) {
+		w_cc_finish(EIO, "PDEV_SET_REGDOMAIN not sent");
+		return;
+	}
+	w_cc_channels_done("PDEV_SET_REGDOMAIN (no regulatory database in the firmware)");
+}
+
+/* WMI_REG_CHAN_LIST_CC_EVENTID (ath11k_pull_reg_chan_list_update_ev): the country the firmware applies and its rules */
+static void
+w_reg_event(const uint8_t *t, uint32_t len)
+{
+	uint32_t h[14] = {};
+	bool have = false;
+	w_fw_nrules = 0;
+	for (uint32_t o = 0; o + 4 <= len;) {
+		uint16_t l, tag;
+		memcpy(&l, t + o, 2);
+		memcpy(&tag, t + o + 2, 2);
+		if (o + 4 + l > len) {
+			break;
+		}
+		const uint8_t *v = t + o + 4;
+		if (tag == TAG_REG_CHAN_LIST_CC && l >= sizeof(h)) {
+			memcpy(h, v, sizeof(h));
+			have = true;
+		} else if (tag == TAG_ARRAY_STRUCT && have) {
+			for (uint32_t q = 0; q + 16 <= l && w_fw_nrules < W_CC_RULES_MOST; q += 16) {
+				uint32_t rt, f, bp, fl;
+				memcpy(&rt, v + q, 4);
+				if ((rt >> 16) != TAG_REGULATORY_RULE) {
+					break;
+				}
+				memcpy(&f, v + q + 4, 4);
+				memcpy(&bp, v + q + 8, 4);
+				memcpy(&fl, v + q + 12, 4);
+				struct wlan_rd_rule *r = &w_fw_rules[w_fw_nrules++];
+				r->lo = (uint16_t)f;
+				r->hi = (uint16_t)(f >> 16);
+				r->max_bw = (uint16_t)bp;
+				r->power = (uint8_t)(bp >> 16);
+				r->flags = (uint16_t)fl;
+			}
+		}
+		o += 4 + l;
+	}
+	if (!have) {
+		LOG("country: REG_CHAN_LIST_CC without its header");
+		return;
+	}
+	char a2[3] = { (char)h[2], (char)(h[2] >> 8), 0 };
+	LOG("t=%u ms: country: firmware REG_CHAN_LIST_CC %s status %u, country %u, domain %x, dfs %u, %u+%u rules", g_ms, a2, h[0],
+	    h[4], h[5], h[6], h[12], h[13]);
+	for (unsigned i = 0; i < w_fw_nrules; i++) {
+		LOG(" rule %u: %u-%u MHz, %u MHz, %u dBm, flags %x", i, w_fw_rules[i].lo, w_fw_rules[i].hi, w_fw_rules[i].max_bw,
+		    w_fw_rules[i].power, w_fw_rules[i].flags);
+	}
+	if (w_fw_cc[0] == 0 && h[0] == REG_CC_STATUS_PASS) {
+		memcpy(w_fw_cc, a2, sizeof(w_fw_cc));   /* the first: the firmware's own */
+		memcpy(w_fw_own_rules, w_fw_rules, sizeof(w_fw_rules));
+		w_fw_own_nrules = w_fw_nrules;
+		w_ch_refresh = scan_started && w_fw_nrules != 0;
+	}
+	if (w_cc_deadline == 0) {
+		return;
+	}
+	if (h[0] != REG_CC_STATUS_PASS) {
+		w_cc_finish(EINVAL, "the firmware refused it");
+		return;
+	}
+	if (w_cc_want[0] == 0) {
+		w_chans_board();
+	} else {
+		(void)w_chans_from_rules(w_fw_rules, w_fw_nrules);
+	}
+	w_cc_channels_done("SET_CURRENT_COUNTRY (the firmware's regulatory database)");
+}
+
+/* the C API (bsd/dev/sapphire_wlan.c) */
+extern "C" {
+struct topaz_wlan_channel { uint16_t frequency, flags; };     /* flags: 1 passive, 2 radar (sys/sapphire_sta.h) */
+int topaz_wlan_set_country(const char *cc, bool *changed);
+void topaz_wlan_country(char cc[3]);
+unsigned topaz_wlan_channels(struct topaz_wlan_channel *out, unsigned most);
+}
+
+#define W_CC_CALLER_WAIT_MS 5000                /* the modem thread waits for a scan to end, then the firmware */
+#define W_CC_CALLER_STEP_MS 100
+
+/* cc: two upper-case letters, or NULL for none. 0 once in force (changed: it was another), or an errno. */
+int
+topaz_wlan_set_country(const char *cc, bool *changed)
+{
+	char want[3] = {};
+	*changed = false;
+	if (!api_ready) {
+		return ENXIO;
+	}
+	if (cc != NULL) {
+		want[0] = cc[0];
+		want[1] = cc[1];
+	}
+	for (int i = 0; i < W_CC_CALLER_WAIT_MS / W_CC_CALLER_STEP_MS && w_cc_asked; i++) {
+		IOSleep(W_CC_CALLER_STEP_MS);           /* (one at a time) */
+	}
+	if (w_cc_asked) {
+		return EBUSY;
+	}
+	if (memcmp(want, w_cc, sizeof(want)) == 0) {
+		return 0;
+	}
+	memcpy(w_cc_want, want, sizeof(want));
+	uint32_t before = w_cc_done;
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	w_cc_asked = true;
+	for (int i = 0; i < W_CC_CALLER_WAIT_MS / W_CC_CALLER_STEP_MS && w_cc_done == before; i++) {
+		IOSleep(W_CC_CALLER_STEP_MS);
+	}
+	if (w_cc_done == before) {
+		return ETIMEDOUT;
+	}
+	*changed = w_cc_result == 0;
+	return w_cc_result;
+}
+
+void
+topaz_wlan_country(char cc[3])
+{
+	memcpy(cc, w_cc, 3);
+}
+
+unsigned
+topaz_wlan_channels(struct topaz_wlan_channel *out, unsigned most)
+{
+	unsigned n = 0;
+	if (w_ch_lock == NULL) {
+		return 0;
+	}
+	IOSimpleLockLock(w_ch_lock);
+	for (; n < w_nch && n < most; n++) {
+		out[n].frequency = w_ch[n].freq;
+		out[n].flags = (uint16_t)((w_ch[n].passive ? 1 : 0) | (w_ch[n].radar ? 2 : 0));
+	}
+	IOSimpleLockUnlock(w_ch_lock);
+	return n;
+}
+
 static void
