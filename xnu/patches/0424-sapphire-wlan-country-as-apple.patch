+/* ---------------- 0424: the country, as wifid sets it (Apple80211 COUNTRY_CODE) */
+
+/*
+ * Apple's driver takes the country wifid decides, has the chip's own regulatory data apply it, asks the chip which
+ * channels that leaves and leaves a network whose channel is gone (01-como-lo-hace-apple.md §2.5). The same here,
+ * the way qcacld-3.0 talks to this firmware family, chosen by what the firmware says it has:
+ *  - with the regulatory database in the firmware (service WMI_SERVICE_REGULATORY_DB): SET_CURRENT_COUNTRY with the
+ *    ISO code; the firmware answers REG_CHAN_LIST_CC with its rules, and the channels come from them;
+ *  - without it: PDEV_SET_REGDOMAIN with qcacld's regdomain, 2/5 GHz domains and test limits of the country, and the
+ *    channels of qcacld's rules for it (both from sapphire_wlan_regdb.h, generated from qcacld's tables).
+ * No country ("" here; wifid's X0/X2/X3/XZ) is the board data's own: SET_CURRENT_COUNTRY with the country the
+ * firmware reported first, or PDEV_SET_REGDOMAIN with the board's eeprom_rd as qcacld starts without a country; and
+ * the channels as at boot. A firmware that starts again (WMI READY once more) gets the country in force again.
+ * Done on the modem thread, between scans and joins; whoever asks waits for it (topaz_wlan_set_country).
+ */
+#define CMD_PDEV_SET_REGDOMAIN   0x4001         /* WMI_TLV_PDEV_SET_REGDOMAIN_CMDID: first command of the PDEV group */
+#define TAG_PDEV_SET_REGDOMAIN   0x51           /* WMI_TLV_TAG_STRUCT_PDEV_SET_REGDOMAIN_CMD */
+#define CMD_SET_CURRENT_COUNTRY  0x3A001        /* WMI_SET_CURRENT_COUNTRY_CMDID: first of the regulatory group 0x3a */
+#define TAG_SET_CURRENT_COUNTRY  0x25F          /* WMI_TLV_TAG_STRUCT_SET_CURRENT_COUNTRY_CMD */
+#define WMI_EV_REG_CHAN_LIST_CC  0x3A001        /* WMI_REG_CHAN_LIST_CC_EVENTID: first event of that group */
+#define TAG_REG_CHAN_LIST_CC     0x261          /* WMI_TLV_TAG_STRUCT_REG_CHAN_LIST_CC_EVENT */
+#define TAG_REGULATORY_RULE      0x260          /* WMI_TLV_TAG_STRUCT_REGULATORY_RULE_STRUCT */
+#define SVC_REGULATORY_DB        117            /* WMI_TLV_SERVICE_REGULATORY_DB (values: ath10k wmi-tlv.h, ath11k wmi.h) */
+#define REG_CC_STATUS_PASS       0              /* WMI_REG_SET_CC_STATUS_PASS */
+#define W_CC_FW_WAIT_MS          2000           /* for REG_CHAN_LIST_CC after SET_CURRENT_COUNTRY */
+static char w_cc[3];                            /* the country in force ("": the board data's own) */
+static char w_cc_want[3];                       /* the one asked for */
+static volatile bool w_cc_asked;
+static volatile uint32_t w_cc_done;             /* bumped when an asked country is in force or refused */
+static volatile int w_cc_result;
+static uint32_t w_cc_deadline;                  /* waiting for REG_CHAN_LIST_CC (0: not) */
+static char w_fw_cc[3];                         /* the firmware's own country (its first REG_CHAN_LIST_CC) */
+static bool w_ch_refresh;                       /* the board's own rules came after the list was sent */
+extern "C" {
+void (*topaz_wlan_channels_hook)(void);         /* the channel list changed (bsd/dev/sapphire_wlan.c) */
+}
+static struct wlan_rd_rule w_fw_rules[W_CC_RULES_MOST];
+static unsigned w_fw_nrules;
+
+static const char *
+w_cc_name(const char *cc)
+{
+	return cc[0] != 0 ? cc : "none (the board data's own)";
+}
+
+static void
+w_cc_finish(int result, const char *how)
+{
+	w_cc_deadline = 0;
+	if (result == 0) {
+		memcpy(w_cc, w_cc_want, sizeof(w_cc));
+	}
+	LOG("t=%u ms: country: %s %s: %s (%d)", g_ms, w_cc_name(w_cc_want), result == 0 ? "in force" : "NOT applied", how, result);
+	w_cc_result = result;
+	w_cc_asked = false;
+	w_cc_done++;
+}
+
+/* before the new channels go to the firmware (Apple: "Disassociating before performing country settings") */
+static void
+w_cc_leave_if_gone(void)
+{
+	if (s_state == S_IDLE || w_chan_of(s_freq) != NULL) {
+		return;
+	}
+	LOG("t=%u ms: country: %u MHz is not a channel of %s: leaving the network", g_ms, s_freq, w_cc_name(w_cc_want));
+	if (s_state == S_UP) {
+		w_teardown();
+	} else {
+		w_join_end(ENETDOWN);
+	}
+}
+
+static void
+w_cc_channels_done(const char *how)
+{
+	w_cc_leave_if_gone();
+	bool ok = w_send_chan_list();
+	LOG("t=%u ms: country: channel list of %s: %u channels %s", g_ms, w_cc_name(w_cc_want), w_nch, ok ? "sent" : "FAILED");
+	w_cc_finish(ok ? 0 : EIO, how);
