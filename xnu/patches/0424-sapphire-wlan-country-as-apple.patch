diff --git a/iokit/Kernel/arm/sapphire_wlan_reg.h b/iokit/Kernel/arm/sapphire_wlan_reg.h
new file mode 100644
index 0000000..209df16
--- /dev/null
+++ b/iokit/Kernel/arm/sapphire_wlan_reg.h
@@ -0,0 +1,202 @@
+/*
+ * sapphire 0424: country -> what the WLAN firmware is told and which channels the host offers, as qcacld-3.0 (the
+ * Qualcomm driver of this firmware family) does it, over the tables tools/wlan-regdb-gen.py generates from it
+ * (sapphire_wlan_regdb.h). Plain C over those tables, nothing of the kernel: TopazModem.cpp uses it, and a host test
+ * can compile it as it is.
+ */
+#ifndef SAPPHIRE_WLAN_REG_H
+#define SAPPHIRE_WLAN_REG_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "sapphire_wlan_regdb.h"
+
+#define WLAN_RD_N(a) (sizeof(a) / sizeof((a)[0]))
+
+/* what WMI_PDEV_SET_REGDOMAIN carries (qcacld wma_send_regdomain_info_to_fw) */
+struct wlan_rd_fw {
+	uint32_t reg_domain;
+	uint16_t dmn_2g, dmn_5g;
+	uint8_t ctl_2g, ctl_5g;
+};
+
+static inline const struct wlan_rd_country *
+wlan_rd_country_by_a2(const char a2[2])
+{
+	for (unsigned i = 0; i < WLAN_RD_N(wlan_rd_countries); i++) {
+		if (wlan_rd_countries[i].a2[0] == a2[0] && wlan_rd_countries[i].a2[1] == a2[1]) {
+			return &wlan_rd_countries[i];
+		}
+	}
+	return 0;
+}
+
+static inline const struct wlan_rd_country *
+wlan_rd_country_by_code(uint16_t code)
+{
+	for (unsigned i = 0; i < WLAN_RD_N(wlan_rd_countries); i++) {
+		if (wlan_rd_countries[i].code == code) {
+			return &wlan_rd_countries[i];
+		}
+	}
+	return 0;
+}
+
+static inline const struct wlan_rd_pair *
+wlan_rd_pair_by_id(uint16_t pair)
+{
+	for (unsigned i = 0; i < WLAN_RD_N(wlan_rd_pairs); i++) {
+		if (wlan_rd_pairs[i].pair == pair) {
+			return &wlan_rd_pairs[i];
+		}
+	}
+	return 0;
+}
+
+static inline bool
+wlan_rd_ctl(uint16_t dmn, uint8_t *ctl)
+{
+	for (unsigned i = 0; i < WLAN_RD_N(wlan_rd_dmns); i++) {
+		if (wlan_rd_dmns[i].dmn == dmn) {
+			*ctl = wlan_rd_dmns[i].ctl;
+			return true;
+		}
+	}
+	return false;
+}
+
+/* cds_fill_and_send_ctl_to_fw(): the pair's 2/5 GHz domains and their conformance test limits */
+static inline bool
+wlan_rd_fill(uint32_t reg_domain, const struct wlan_rd_pair *pair, struct wlan_rd_fw *out)
+{
+	if (pair == 0 || !wlan_rd_ctl(pair->dmn_2g, &out->ctl_2g) || !wlan_rd_ctl(pair->dmn_5g, &out->ctl_5g)) {
+		return false;
+	}
+	out->reg_domain = reg_domain;
+	out->dmn_2g = pair->dmn_2g;
+	out->dmn_5g = pair->dmn_5g;
+	return true;
+}
+
+/* A country (ISO alpha2): hdd_update_regulatory_info() makes the regdomain CTRY_FLAG | country code. */
+static inline bool
+wlan_rd_fw_for_country(const char a2[2], struct wlan_rd_fw *out)
+{
+	const struct wlan_rd_country *c = wlan_rd_country_by_a2(a2);
+	return c != 0 && wlan_rd_fill(WLAN_RD_CTRY_FLAG | c->code, wlan_rd_pair_by_id(c->pair), out);
+}
+
+/*
+ * No country: the board data's own regdomain (eeprom_rd of HAL_REG_CAPABILITIES), resolved as
+ * cds_fill_some_regulatory_info() does when qcacld starts without one (reg_dmn_sanitize, get_bdf_reg_dmn,
+ * reg_dmn_get_default_country): a country, or a regdomain pair with no country. *country gets the country's code, or
+ * CTRY_DEFAULT for a pair; *pair the pair id. (qcacld's is_reg_dmn_valid() looks before the roaming flag comes off and
+ * so refuses a pair with it, e.g. the generic bdwlan.bin's 0x406C; here the flag comes off first, as get_bdf_reg_dmn.)
+ */
+static inline bool
+wlan_rd_board(uint16_t eeprom_rd, uint16_t *rd_out, uint16_t *country, uint16_t *pair)
+{
+	uint16_t rd = eeprom_rd == WLAN_RD_CTRY_FLAG ? WLAN_RD_WOR0_WORLD : eeprom_rd;
+	uint16_t dmn = rd & (uint16_t)~WLAN_RD_WORLD_ROAMING_FLAG;
+	const struct wlan_rd_country *c;
+	const struct wlan_rd_pair *p;
+
+	*country = WLAN_RD_CTRY_DEFAULT;
+	if ((dmn & WLAN_RD_CTRY_FLAG) != 0) {
+		*country = dmn & (uint16_t)~WLAN_RD_CTRY_FLAG;
+	} else if ((p = wlan_rd_pair_by_id(dmn)) != 0) {
+		*country = p->single_cc;
+	} else {
+		return false;
+	}
+	if (*country == WLAN_RD_CTRY_DEFAULT && dmn == WLAN_RD_CTRY_DEFAULT) {
+		*country = WLAN_RD_CTRY_UNITED_STATES;
+	}
+	if (*country != WLAN_RD_CTRY_DEFAULT) {
+		if ((c = wlan_rd_country_by_code(*country)) == 0) {
+			return false;
+		}
+		*pair = c->pair;
+	} else {
+		*pair = dmn;
+	}
+	*rd_out = rd;
+	return true;
+}
+
+static inline bool
+wlan_rd_fw_for_board(uint16_t eeprom_rd, struct wlan_rd_fw *out)
+{
+	uint16_t rd, country, pair;
+	return wlan_rd_board(eeprom_rd, &rd, &country, &pair) && wlan_rd_fill(rd, wlan_rd_pair_by_id(pair), out);
+}
+
+/* reg_db.c's rules of a country (2 GHz first, then 5 GHz) */
+static inline const struct wlan_rd_rule *
+wlan_rd_rules_of(const char a2[2], unsigned *count)
+{
+	for (unsigned i = 0; i < WLAN_RD_N(wlan_rd_chan); i++) {
+		if (wlan_rd_chan[i].a2[0] == a2[0] && wlan_rd_chan[i].a2[1] == a2[1]) {
+			*count = wlan_rd_chan[i].count;
+			return &wlan_rd_rules[wlan_rd_chan[i].first];
+		}
+	}
+	*count = 0;
+	return 0;
+}
+
+/* reg_db.c's rules of a regdomain pair */
+static inline const struct wlan_rd_rule *
+wlan_rd_rules_of_pair(uint16_t pair, unsigned *count)
+{
+	for (unsigned i = 0; i < WLAN_RD_N(wlan_rd_pair_rules); i++) {
+		if (wlan_rd_pair_rules[i].pair == pair) {
+			*count = wlan_rd_pair_rules[i].count;
+			return &wlan_rd_rules[wlan_rd_pair_rules[i].first];
+		}
+	}
+	*count = 0;
+	return 0;
+}
+
+/* the rules of the board data's own regdomain: its country's, or its pair's */
+static inline const struct wlan_rd_rule *
+wlan_rd_rules_of_board(uint16_t eeprom_rd, unsigned *count, char a2[3])
+{
+	uint16_t rd, country, pair;
+	const struct wlan_rd_country *c;
+
+	a2[0] = a2[1] = a2[2] = 0;
+	*count = 0;
+	if (!wlan_rd_board(eeprom_rd, &rd, &country, &pair)) {
+		return 0;
+	}
+	if (country != WLAN_RD_CTRY_DEFAULT && (c = wlan_rd_country_by_code(country)) != 0) {
+		a2[0] = c->a2[0];
+		a2[1] = c->a2[1];
+		return wlan_rd_rules_of(c->a2, count);
+	}
+	return wlan_rd_rules_of_pair(pair, count);
+}
+
+/*
+ * Whether a 20 MHz channel centred on freq fits in a rule that is not disabled (reg_fill_channel_info: the channel's
+ * edges inside the rule's range); the first such rule gives its flags and power in dBm.
+ */
+#define WLAN_RD_HALF_20MHZ 10
+static inline bool
+wlan_rd_channel_allowed(const struct wlan_rd_rule *rules, unsigned count, unsigned freq, uint16_t *flags,
+    uint8_t *power_dbm)
+{
+	for (unsigned i = 0; i < count; i++) {
+		if (rules[i].lo + WLAN_RD_HALF_20MHZ <= freq && freq + WLAN_RD_HALF_20MHZ <= rules[i].hi &&
+		    (rules[i].flags & WLAN_RD_CHAN_DISABLED) == 0) {
+			*flags = rules[i].flags;
+			*power_dbm = rules[i].power;
+			return true;
+		}
+	}
+	return false;
+}
+
+#endif
