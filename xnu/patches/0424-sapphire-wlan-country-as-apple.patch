+	for (int i = 0; i < 2; i++) {
+		cc[i] = (char)(asked.cc[i] >= 'a' && asked.cc[i] <= 'z' ? asked.cc[i] - 'a' + 'A' : asked.cc[i]);
+	}
+	sapphire_sta_country(before);
+	if (asked.version != COUNTRY_VERSION || cc[0] < 'A' || cc[0] > 'Z' || cc[1] < 'A' || cc[1] > 'Z') {
+		snprintf(said, said_size, " (country: version %u, not two letters: refused)", asked.version);
+		return EINVAL;
+	}
+	none = cc[0] == COUNTRY_DEFAULT_PREFIX;
+	error = sapphire_sta_set_country(none ? NULL : cc, &changed);
