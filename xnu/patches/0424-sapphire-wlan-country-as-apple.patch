+/* 0424: the country goes straight to the station side, on the caller's thread (as state() does) */
+static const struct sapphire_sta_ops *
+sta_read_begin(void)
+{
+	const struct sapphire_sta_ops *ops;
+
+	lck_mtx_lock(&sta_lock);
+	if ((ops = sta_ops) != NULL) {
+		sta_reads++;
+	}
+	lck_mtx_unlock(&sta_lock);
+	return ops;
+}
+
+static void
+sta_read_end(void)
+{
+	lck_mtx_lock(&sta_lock);
+	sta_reads--;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_calls);
+}
+
+void
+sapphire_sta_channels_changed(void)
+{
+	static struct sapphire_sta_channel fresh[CHANNELS_MOST];        /* (one caller: the modem thread) */
+	const struct sapphire_sta_ops *ops = sta_read_begin();
+	unsigned count;
+
+	if (ops == NULL) {
+		return;
+	}
+	count = ops->channels(fresh, CHANNELS_MOST);
+	lck_mtx_lock(&sta_lock);
+	memcpy(channels, fresh, count * sizeof(fresh[0]));
+	channel_count = count;
+	lck_mtx_unlock(&sta_lock);
+	sta_read_end();
+}
+
+int
+sapphire_sta_set_country(const char *country, bool *changed)
+{
+	const struct sapphire_sta_ops *ops = sta_read_begin();
+	int error;
+
+	*changed = false;
+	if (ops == NULL) {
+		return ENXIO;
+	}
+	error = ops->set_country != NULL ? ops->set_country(country, changed) : EOPNOTSUPP;
+	sta_read_end();
+	return error;
+}
+
+void
+sapphire_sta_country(char country[3])
+{
+	const struct sapphire_sta_ops *ops = sta_read_begin();
+
+	country[0] = 0;
+	if (ops != NULL) {
+		if (ops->country != NULL) {
+			ops->country(country);
+		}
+		sta_read_end();
+	}
+}
