+static int
+set_country(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_country_code_data asked;
+	char before[3], cc[3] = {};
+	bool none, changed = false;
+	int error;
+
+	if (request->req_len < offsetof(struct apple80211_country_code_data, cc) + 2) {
+		return EINVAL;
+	}
+	bzero(&asked, sizeof(asked));
+	if ((error = copyin(request->req_data, &asked, request->req_len < sizeof(asked) ? request->req_len : sizeof(asked))) != 0) {
+		return error;
