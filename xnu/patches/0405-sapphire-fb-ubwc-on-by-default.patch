  */
-static int gpu_ubwc;                            /* boot-arg gpu_ubwc, kern.sweet_gpu_ubwc */
+static int gpu_ubwc = 1;                        /* boot-arg gpu_ubwc, kern.sweet_gpu_ubwc; 0405: kgsl's values by default */
 
 extern "C" int
 sapphire_gpu_ubwc_mode(void)
