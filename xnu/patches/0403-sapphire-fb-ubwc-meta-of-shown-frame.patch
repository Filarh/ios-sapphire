+	static bool ubwcPlane;
+	static uint32_t linear[7];                      /* SRC2_ADDR, YSTRIDE1, FORMAT, UNPACK, OP_MODE, UBWC_STATIC_CTRL, FETCH */
+	static const uint16_t linearOff[7] = { 0x1c, 0x28, 0x30, 0x34, 0x38, 0x44, 0x48 };
+	if (sweet_fb_ubwc != 0 && q != NULL && q->ubwc) {
+		if (!ubwcPlane) {
+			for (unsigned k = 0; k < 7; k++) {
+				linear[k] = fVig0[linearOff[k] / 4];
