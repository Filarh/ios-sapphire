 		fVig0[0x38 / 4] = fPlane0[26] | 0x80000001u; /* PE_OVERRIDE | BWC_EN */
 		fVig0[0x48 / 4] = sweet_fb_ubwc_fetch;        /* 0401: SSPP_FETCH_CONFIG as Android writes it */
 		fVig0[0x44 / 4] = sweet_fb_ubwc_sspp_static;  /* 0401: SSPP_UBWC_STATIC_CTRL as Android writes it */
-		if (sweet_fb_ubwc_unpack_found == 0) {
-			sweet_fb_ubwc_unpack_found = fVig0[0x34 / 4];
-		}
 		fVig0[0x34 / 4] = sweet_fb_ubwc_unpack != 0 ? sweet_fb_ubwc_unpack : sweet_fb_ubwc_unpack_found;   /* 0402 */
 		if (sweet_fb_ubwc_nocrop != 0) {
 			fVig0[0x08 / 4] = 0;                  /* 0402: SRC_XY */
@@ -3339,6 +3352,12 @@
 			sweet_fb_ubwc_last_error = ubwcStatus;
 			sweet_fb_ubwc_errors++;
 		}
+	} else if (ubwcPlane) {
+		for (unsigned k = 0; k < 7; k++) {
