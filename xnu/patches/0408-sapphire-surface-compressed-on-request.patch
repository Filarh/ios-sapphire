-	    s->pixelFormat != 0x42475241 || s->bytesPerElement != 4 || s->planeCount > 1 || s->elementWidth != 1 ||
+	    (s->pixelFormat != 0x42475241 && s->pixelFormat != 0x26424741) || s->bytesPerElement != 4 || s->planeCount > 1 || s->elementWidth != 1 ||
 	    s->elementHeight != 1 || s->offset != 0 || (s->bytesPerRow & 63) != 0 || s->allocSize > sweet_pool_slot_size) {
 		return false;
 	}
@@ -929,6 +929,17 @@ sweet_surface_fill_result(SweetSurface *s, SweetSurfaceRef *ref, uint8_t *out)
 		memcpy(p + 0x18, &pl->bytesPerElement, 2);
 		p[0x1a] = pl->elementWidth;
 		p[0x1b] = pl->elementHeight;
+		if (i == 0 && s->ubwc) {
+			/*
+			 * 0408: the plane as compressed, where IOSurface.framework reads it (IOSurfaceClient + 0x124 + plane * 0x80 for
+			 * IOSurfaceGetCompressionTypeOfPlane; the compressed-tile header and data regions' offsets at + 0x10c / + 0x110):
+			 * type 2, the one QuartzCore's AGX plane description gives without universal compression. Its metadata (the
+			 * headers) at the start, the data after them, in UBWC's layout.
+			 */
+			p[0x54] = 2;
+			put32(p, 0x3c, s->ubwcMetaOffset);
+			put32(p, 0x40, s->ubwcDataOffset);
+		}
 	}
 }
 
